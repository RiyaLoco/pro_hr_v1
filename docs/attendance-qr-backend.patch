+<?php
+
+namespace App\Support;
+
+use InvalidArgumentException;
+
+/** Parses attendance action templates and existing resolved office URLs. */
+final class AttendanceQr
+{
+    // Only compensates for decimal rounding of a configured branch coordinate.
+    // The employee's policy, not this tolerance, controls the phone GPS radius.
+    private const COORDINATE_EPSILON = 0.000001;
+
+    /** Use this text in each branch's existing QR generator. */
+    public static function forBranch(int $branchId, string $apiBaseUrl): string
+    {
+        if ($branchId <= 0) {
+            throw new InvalidArgumentException('A valid branch ID is required.');
+        }
+        $code = rtrim($apiBaseUrl, '/').'/employee/attendance/{attendance_type_id}/{check_location}?branch_id='.$branchId;
+        self::parse($code, $apiBaseUrl);
+
+        return $code;
+    }
+
+    public static function parse(string $code, string $apiBaseUrl): array
+    {
+        $action = trim($code);
+        if ($action === '' || strlen($action) > 4096) {
+            throw new InvalidArgumentException('Scan a valid office attendance QR code.');
+        }
+        if (str_starts_with($action, 'action=')) {
+            parse_str($action, $parameters);
+            if (count($parameters) !== 1 || ! is_string($parameters['action'] ?? null)) {
+                throw new InvalidArgumentException('Scan a valid office attendance QR code.');
+            }
+            $action = trim($parameters['action']);
+        }
+
+        $api = parse_url($apiBaseUrl);
+        $url = parse_url($action);
+        if ($api === false || ! isset($api['scheme'], $api['host']) ||
+            ! in_array(strtolower($api['scheme']), ['http', 'https'], true)) {
+            throw new InvalidArgumentException('The attendance QR server URL is not configured correctly.');
+        }
+        if ($url === false || ! isset($url['path']) ||
+            isset($url['fragment']) ||
+            isset($url['user']) || isset($url['pass'])) {
+            throw new InvalidArgumentException('This QR code is not a valid attendance action.');
+        }
+
+        $branchId = null;
+        if (isset($url['query'])) {
+            parse_str($url['query'], $parameters);
+            $value = $parameters['branch_id'] ?? null;
+            if (count(explode('&', $url['query'])) !== 1 || count($parameters) !== 1 ||
+                ! is_string($value) || ! preg_match('/^[1-9][0-9]*$/D', $value)) {
+                throw new InvalidArgumentException('The attendance QR has an invalid branch ID.');
+            }
+            $branchId = filter_var($value, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
+            if ($branchId === false) {
+                throw new InvalidArgumentException('The attendance QR has an invalid branch ID.');
+            }
+        }
+        if (isset($url['scheme']) || isset($url['host'])) {
+            $scheme = strtolower($url['scheme'] ?? '');
+            $apiScheme = strtolower($api['scheme']);
+            $port = $url['port'] ?? ($scheme === 'https' ? 443 : 80);
+            $apiPort = $api['port'] ?? ($apiScheme === 'https' ? 443 : 80);
+            if ($scheme !== $apiScheme ||
+                strtolower($url['host'] ?? '') !== strtolower($api['host']) ||
+                $port !== $apiPort) {
+                throw new InvalidArgumentException('This QR code is not for this attendance service.');
+            }
+        }
+
+        $prefix = explode('/', trim($api['path'] ?? '', '/').'/employee/attendance');
+        if ($prefix[0] === '') {
+            array_shift($prefix);
+        }
+        $path = str_starts_with($url['path'], '/') ? substr($url['path'], 1) : $url['path'];
+        $segments = array_map('rawurldecode', explode('/', $path));
+        if (count($segments) !== count($prefix) + 2 ||
+            array_slice($segments, 0, count($prefix)) !== $prefix) {
+            throw new InvalidArgumentException('This QR code is not an attendance action.');
+        }
+        if ($segments[count($prefix)] === '{attendance_type_id}' &&
+            $segments[count($prefix) + 1] === '{check_location}') {
+            return [
+                'is_template' => true,
+                'branch_id' => $branchId,
+                'attendance_type_id' => null,
+                'latitude' => null,
+                'longitude' => null,
+                'location' => null,
+                'hash' => hash('sha256', trim($code)),
+            ];
+        }
+        $type = filter_var($segments[count($prefix)], FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
+        if ($type === false) {
+            throw new InvalidArgumentException('The attendance QR code has an invalid type.');
+        }
+        [$latitude, $longitude] = self::coordinates($segments[count($prefix) + 1]);
+
+        return [
+            'is_template' => false,
+            'branch_id' => $branchId,
+            'attendance_type_id' => $type,
+            'latitude' => $latitude,
+            'longitude' => $longitude,
+            'location' => $latitude.','.$longitude,
+            'hash' => hash('sha256', trim($code)),
+        ];
+    }
+
+    public static function coordinates(string $location): array
+    {
+        $parts = explode(',', $location);
+        if (count($parts) !== 2 || ! is_numeric(trim($parts[0])) || ! is_numeric(trim($parts[1]))) {
+            throw new InvalidArgumentException('A location must contain valid latitude,longitude coordinates.');
+        }
+        $latitude = (float) trim($parts[0]);
+        $longitude = (float) trim($parts[1]);
+        if (! is_finite($latitude) || ! is_finite($longitude) || abs($latitude) > 90 || abs($longitude) > 180) {
+            throw new InvalidArgumentException('Latitude or longitude is out of range.');
+        }
+
+        return [$latitude, $longitude];
+    }
+
+    /** Unrounded meters for comparisons with policy.radius_allowance. */
+    public static function distanceMeters(string $from, string $to): float
+    {
+        [$lat1, $lon1] = self::coordinates($from);
+        [$lat2, $lon2] = self::coordinates($to);
+        $a = sin(deg2rad($lat2 - $lat1) / 2) ** 2 +
+            cos(deg2rad($lat1)) * cos(deg2rad($lat2)) * sin(deg2rad($lon2 - $lon1) / 2) ** 2;
+        $a = max(0.0, min(1.0, $a));
+
+        return 6371000.0 * 2 * atan2(sqrt($a), sqrt(1 - $a));
+    }
+
+    public static function matchesBranchLocation(array $qr, string $branchLocation): bool
+    {
+        [$latitude, $longitude] = self::coordinates($branchLocation);
+
+        // The controller separately enforces branch_id, employee permissions
+        // and the phone GPS radius. Placeholders never bypass those checks.
+        if ($qr['is_template']) {
+            return true;
+        }
+
+        return abs($qr['latitude'] - $latitude) <= self::COORDINATE_EPSILON &&
+            abs($qr['longitude'] - $longitude) <= self::COORDINATE_EPSILON;
+    }
+}
